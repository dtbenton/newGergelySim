# Expected filename structure:
# Study_sim1a_pEpochs_900_control_tEpochs_8_lr_0.0975_sLR_0.003875_sWD_0.0975.txt
#
# Windows may hide the .txt extension, so the extension is treated as optional.
files = list.files(
pattern = paste0(
"^Study_sim1a_",
"pEpochs_[0-9]+_",
"(control|hab)_",
"tEpochs_[0-9]+_",
"lr_[0-9.]+_",
"sLR_[0-9.]+_",
"sWD_[0-9.]+",
"(\\.[A-Za-z0-9]+)?$"
)
)
stopifnot(length(files) > 0)
data_list = lapply(files, function(f) {
# Create one dataframe from each file
df = read.table(
f,
header = FALSE,
stringsAsFactors = FALSE
)
# Extract metadata from the filename
df$pEpochs = as.numeric(
sub("^.*_pEpochs_([0-9]+)_.*$", "\\1", f)
)
df$condition = sub(
"^.*_(control|hab)_tEpochs_.*$",
"\\1",
f
)
df$tEpochs = as.numeric(
sub("^.*_tEpochs_([0-9]+)_.*$", "\\1", f)
)
df$lr = as.numeric(
sub("^.*_lr_([0-9.]+)_sLR_.*$", "\\1", f)
)
df$sLR = as.numeric(
sub("^.*_sLR_([0-9.]+)_sWD_.*$", "\\1", f)
)
df$sWD = as.numeric(
sub(
"^.*_sWD_([0-9.]+)(\\.[A-Za-z0-9]+)?$",
"\\1",
f
)
)
df$source_file = f
# Return this file's dataframe to data_list
df
})
# data_list contains one dataframe per file
names(data_list) = files
# Collate all file-level dataframes into one complete dataframe
D = do.call(rbind, data_list)
# Clean inherited row names
rownames(D) = NULL
# Confirm that every matched file was included
cat("Files read:", length(files), "\n")
cat("Dataframes created:", length(data_list), "\n")
cat("Rows in D:", nrow(D), "\n")
fix(D)
