files <- list.files(
pattern = paste0(
"^Study_sim1a_",
"pEpochs_[0-9]+_",
"(control|hab)_",
"tEpochs_[0-9]+_",
"lr_[0-9.]+_",
"sLR_[0-9.]+_",
"sWD_[0-9.]+",
"(\\.txt)?$"
),
full.names = FALSE
)
stopifnot(length(files) > 0)
# One dataframe is created for every file.
data_list <- lapply(files, function(f) {
df <- read.table(
file = f,
header = FALSE,
stringsAsFactors = FALSE
)
df$pEpochs <- as.numeric(
sub("^.*_pEpochs_([0-9]+)_.*$", "\\1", f)
)
df$condition <- sub(
"^.*_(control|hab)_tEpochs_.*$",
"\\1",
f
)
df$tEpochs <- as.numeric(
sub("^.*_tEpochs_([0-9]+)_.*$", "\\1", f)
)
df$lr <- as.numeric(
sub("^.*_lr_([0-9.]+)_sLR_.*$", "\\1", f)
)
df$sLR <- as.numeric(
sub("^.*_sLR_([0-9.]+)_sWD_.*$", "\\1", f)
)
df$sWD <- as.numeric(
sub("^.*_sWD_([0-9.]+)(\\.txt)?$", "\\1", f)
)
df$source_file <- f
return(df)
})
# Give each individual dataframe the name of its source file.
names(data_list) <- files
# Collate all individual dataframes into one complete dataframe.
D <- do.call(rbind, data_list)
rownames(D) <- NULL
fix(D)
