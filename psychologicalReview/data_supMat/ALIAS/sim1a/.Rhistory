file_pattern <- paste0(
"^Study_sim1a_",
"pEpochs_[0-9]+_",
"(control|hab)_",
"tEpochs_[0-9]+_",
"lr_[0-9.]+_",
"sLR_[0-9.]+_",
"sWD_[0-9.]+",
"(\\.txt)?$"
)
files <- list.files(pattern = file_pattern)
stopifnot(length(files) > 0)
data_list <- lapply(files, function(f) {
df <- read.table(
f,
header = FALSE,
stringsAsFactors = FALSE
)
df$pEpochs <- as.numeric(
sub("^.*_pEpochs_([0-9]+)_.*$", "\\1", f)
)
df$condition <- sub(
"^.*_(control|hab)_tEpochs_.*$",
"\\1",
f
)
df$tEpochs <- as.numeric(
sub("^.*_tEpochs_([0-9]+)_.*$", "\\1", f)
)
df$lr <- as.numeric(
sub("^.*_lr_([0-9.]+)_sLR_.*$", "\\1", f)
)
df$sLR <- as.numeric(
sub("^.*_sLR_([0-9.]+)_sWD_.*$", "\\1", f)
)
df$sWD <- as.numeric(
sub(
"^.*_sWD_([0-9.]+)(\\.txt)?$",
"\\1",
f
)
)
df$source_file <- f
df
})
D <- do.call(rbind, data_list)
rownames(D) <- NULL
dim(D)
fix(D)
