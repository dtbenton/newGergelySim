set.seed(123)
N = 20
D = expand.grid(
id = 1:N,
condition = c("Experimental", "Control"),
trialType = c("Efficient", "Inefficient")
)
fix(D)
D$lookingTime = NA
# Experimental condition
D$lookingTime[D$condition == "Experimental" &
D$trialType == "Efficient"] =
rnorm(N, 8, 1.5)
D$lookingTime[D$condition == "Experimental" &
D$trialType == "Inefficient"] =
rnorm(N, 12, 1.5)
# Control condition
D$lookingTime[D$condition == "Control" &
D$trialType == "Efficient"] =
rnorm(N, 9, 1.5)
D$lookingTime[D$condition == "Control" &
D$trialType == "Inefficient"] =
rnorm(N, 9, 1.5)
fix(D)
names(D)
condition_barplot = ggplot(D, aes(condition, lookingTime, fill=trialType)) # create the bar graph with test.trial.2 on the x-axis and measure on the y-axis
