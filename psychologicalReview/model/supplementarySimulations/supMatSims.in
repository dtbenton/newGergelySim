##########################################################################################
# The functions specified below correspond to the simulations reported in the manuscript #
##########################################################################################

## Author: Deon T. Benton 

# Simulation 1a: Selective longer looking to inefficient actions 
# Simulated age: 12-month-olds

proc wrapSim1a {} {
	proc gsSim_sim1a {netName lr sLR sWD} {
		addNet $netName -i 8

		# specify the input groups
		addGroup Object_Left_IN 82 INPUT OUT_NOISE
		addGroup Object_Right_IN 82 INPUT  OUT_NOISE
		addGroup Object_Left_Animate_Status_IN 2 INPUT OUT_NOISE 
		addGroup Object_Right_Animate_Status_IN 2 INPUT  OUT_NOISE
		addGroup Grid_IN 5 INPUT  OUT_NOISE
		addGroup Grid_Position_IN 3 INPUT OUT_NOISE 
		addGroup Jump_Height_IN 5 INPUT OUT_NOISE 
		addGroup Motion_IN 6 INPUT OUT_NOISE
		addGroup Motion_Type_IN 2 INPUT OUT_NOISE
		addGroup Goal_IN 1 INPUT OUT_NOISE
		addGroup Clearance_IN 3 INPUT OUT_NOISE

		# specify the hidden groups
		# Note: there are necessarily fewer hidden units than there are input and output units
		addGroup context 50 ELMAN
		addGroup hidden 50 RELU
		
		# specify the amount of normalized noise to inject in each input group
		noiseType Object_Left_IN -range 0.3
		noiseType Object_Right_IN -range 0.3
		noiseType Object_Left_Animate_Status_IN -range 0.3
		noiseType Object_Right_Animate_Status_IN -range 0.3
		noiseType Grid_IN -range 0.3
		noiseType Grid_Position_IN -range 0.3
		noiseType Jump_Height_IN -range 0.3
		noiseType Motion_IN -range 0.3
		noiseType Motion_Type_IN -range 0.3
		noiseType Goal_IN -range 0.3
		noiseType Clearance_IN -range 0.3
			

		# specify the output groups
		addGroup Object_Left_OUT 82 OUTPUT 
		addGroup Object_Right_OUT 82 OUTPUT 
		addGroup Object_Left_Animate_Status_OUT 2 OUTPUT
		addGroup Object_Right_Animate_Status_OUT 2 OUTPUT
		addGroup Grid_OUT 5 OUTPUT 
		addGroup Grid_Position_OUT 3 OUTPUT
		addGroup Jump_Height_OUT 5 OUTPUT
		addGroup Motion_OUT 6 OUTPUT
		addGroup Motion_Type_OUT 2 OUTPUT
		addGroup Goal_OUT 1 OUTPUT  
		addGroup Clearance_OUT 3 OUTPUT


		# specify how groups are connected as well as any special connection "types"
		connectGroups {Object_Left_IN Object_Right_IN Object_Left_Animate_Status_IN Object_Right_Animate_Status_IN Motion_IN Goal_IN Clearance_IN Jump_Height_IN Motion_Type_IN context} hidden {Object_Left_OUT Object_Right_OUT Object_Left_Animate_Status_OUT Object_Right_Animate_Status_OUT Motion_OUT Goal_OUT Clearance_OUT Jump_Height_OUT Motion_Type_OUT}

		connectGroups {Grid_IN Grid_Position_IN} hidden -type barrierSalience
		connectGroups hidden {Grid_OUT Grid_Position_OUT} -type barrierSalience

		elmanConnect hidden context

		deleteGroups bias

		# training examples
		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1a/pretrain.ex" -e PERMUTED

		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1a/sim1aExpHab.ex" 
		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1a/sim1aCntrlHab.ex" 
		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1a/sim1aTest.ex"
		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1a/sim1aCntrlTest.ex"

		# set learning and display parameters
		setObj learningRate $lr
		setObj momentum	    0
		setObj batchSize    0
		setObj numUpdates   10
		setObj randRange 0.1
		setObj reportInterval 0
		setObj pseudoExampleFreq 1

		# create a function that gets the error for each test example
		proc saveActivations {fname} { 
			set outfile [open $fname a] 
			puts $outfile "[getObj currentExample.num] [getObj currentExample.name] " nonewline 
			puts $outfile [getObj exampleError]
			close $outfile 
		}

		proc testAllFinalActs {fname} { 
			resetExampleSet [getObj testingSet.name] 
			set nex [getObj testingSet.numExamples] 
			for {set i 0} {$i < $nex} {incr i} {
				doExample -set [getObj testingSet.name]
				saveActivations $fname
			}
		}

		proc testNetwork {n train trainNum train2 trainNum2 test fname} {
			for {set i 0} {$i < $n} {incr i} {
				resetNet
				useTrainingSet $train
				train $trainNum
				useTrainingSet $train2
				train $trainNum2
				useTestingSet $test
				testAllFinalActs $fname
			}
		}


		# define lists for looping
		set study [list sim1a sim1a]
		set condition [list hab control]
		set habEvent [list sim1aExpHab sim1aCntrlHab]
		set testEvent [list sim1aTest sim1aTest]
		set pretrainingEpochs [list 900]
		set trainingEpochs [list 8 9 10 11 12]


		# define loop

		foreach stud $study cond $condition hEvent $habEvent tEvent $testEvent {
			set workingdirectory "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/data_supMat/ALIAS/sim1a"
			cd $workingdirectory
			foreach tEpochs $trainingEpochs {
				foreach epochs $pretrainingEpochs {
					testNetwork 1 pretrain $epochs $hEvent $tEpochs $tEvent Study_${stud}_pEpochs_${epochs}_${cond}_tEpochs_${tEpochs}_lr_${lr}_sLR_${sLR}_sWD_${sWD}.txt
				}
			}
		}
	}
# parameter lists (#differences 125
set learningRate [list 0.09875 0.0975] 
set salientLR [list 0.0004 .0003875]
set salientWD [list 0.09875 0.0975]

# grid search loops
	foreach lrSalient $learningRate sLR $salientLR sWD $salientWD {
		set ::s_LR $sLR
		set ::s_WD $sWD
		
		
		gsSim_sim1a net_${lrSalient}_sLR_${sLR}_sWD_${sWD} $lrSalient $sLR $sWD
	}

}

# gsSim_sim1a net$lrSalient$sLR$sWD $lrSalient $sLR $sWD
# 12 mos
# Simulation 1b: checking whether the effect in Simulation 1 is robust to "inconsistent" prior experience
# 12 mos
proc wrapSim1b_100 {} {
	proc gsSim_sim1b_100 {netName lr sLR sWD} {
		addNet $netName -i 8

		# input groups
		addGroup Object_Left_IN 82 INPUT OUT_NOISE
		addGroup Object_Right_IN 82 INPUT  OUT_NOISE
		addGroup Object_Left_Animate_Status_IN 2 INPUT OUT_NOISE 
		addGroup Object_Right_Animate_Status_IN 2 INPUT  OUT_NOISE
		addGroup Grid_IN 5 INPUT  OUT_NOISE
		addGroup Grid_Position_IN 3 INPUT OUT_NOISE 
		addGroup Jump_Height_IN 5 INPUT OUT_NOISE 
		addGroup Motion_IN 6 INPUT OUT_NOISE
		addGroup Motion_Type_IN 2 INPUT OUT_NOISE
		addGroup Goal_IN 1 INPUT OUT_NOISE
		addGroup Clearance_IN 3 INPUT OUT_NOISE

		# hidden group (# there are necessarily fewer hidden units than there are input and output units)
		addGroup context 50 ELMAN
		addGroup hidden 50 RELU
		
		# noise parameters
		noiseType Object_Left_IN -range 0.3
		noiseType Object_Right_IN -range 0.3
		noiseType Object_Left_Animate_Status_IN -range 0.3
		noiseType Object_Right_Animate_Status_IN -range 0.3
		noiseType Grid_IN -range 0.3
		noiseType Grid_Position_IN -range 0.3
		noiseType Jump_Height_IN -range 0.3
		noiseType Motion_IN -range 0.3
		noiseType Motion_Type_IN -range 0.3
		noiseType Goal_IN -range 0.3
		noiseType Clearance_IN -range 0.3
			

		# output group
		addGroup Object_Left_OUT 82 OUTPUT 
		addGroup Object_Right_OUT 82 OUTPUT 
		addGroup Object_Left_Animate_Status_OUT 2 OUTPUT
		addGroup Object_Right_Animate_Status_OUT 2 OUTPUT
		addGroup Grid_OUT 5 OUTPUT 
		addGroup Grid_Position_OUT 3 OUTPUT
		addGroup Jump_Height_OUT 5 OUTPUT
		addGroup Motion_OUT 6 OUTPUT
		addGroup Motion_Type_OUT 2 OUTPUT
		addGroup Goal_OUT 1 OUTPUT  
		addGroup Clearance_OUT 3 OUTPUT


		# connect groups (input -> hidden -> output)
		connectGroups {Object_Left_IN Object_Right_IN Object_Left_Animate_Status_IN Object_Right_Animate_Status_IN Motion_IN Goal_IN Clearance_IN Jump_Height_IN Motion_Type_IN context} hidden {Object_Left_OUT Object_Right_OUT Object_Left_Animate_Status_OUT Object_Right_Animate_Status_OUT Motion_OUT Goal_OUT Clearance_OUT Jump_Height_OUT Motion_Type_OUT}

		connectGroups {Grid_IN Grid_Position_IN} hidden -type barrierSalience
		connectGroups hidden {Grid_OUT Grid_Position_OUT} -type barrierSalience

		elmanConnect hidden context

		deleteGroups bias

		# training examples
		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/pretrain_100_0.ex" -e PERMUTED
		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/pretrain_90_10.ex" -e PERMUTED
		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/pretrain_80_20.ex" -e PERMUTED
		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/pretrain_70_30.ex" -e PERMUTED
		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/pretrain_60_40.ex" -e PERMUTED
		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/pretrain_50_50.ex" -e PERMUTED

		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/sim1bExpHab.ex" 
		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/sim1bCntrlHab.ex" 
		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/sim1bTest.ex"

		# set learning and display parameters
		setObj learningRate $lr
		setObj momentum	    0
		setObj batchSize    0
		setObj numUpdates   10
		setObj randRange 0.1
		setObj reportInterval 0
		setObj pseudoExampleFreq 1

		# create a function that gets the error for each test example
		proc saveActivations {fname} { 
			set outfile [open $fname a] 
			puts $outfile "[getObj currentExample.num] [getObj currentExample.name] " nonewline 
			puts $outfile [getObj exampleError]
			close $outfile 
		}

		proc testAllFinalActs {fname} { 
			resetExampleSet [getObj testingSet.name] 
			set nex [getObj testingSet.numExamples] 
			for {set i 0} {$i < $nex} {incr i} {
				doExample -set [getObj testingSet.name]
				saveActivations $fname
			}
		}

		proc testNetwork {n train trainNum train2 trainNum2 test fname} {
			for {set i 0} {$i < $n} {incr i} {
				resetNet
				useTrainingSet $train
				train $trainNum
				useTrainingSet $train2
				train $trainNum2
				useTestingSet $test
				testAllFinalActs $fname
			}
		}


		# define lists for looping
		set condition [list pretrain1000]
		set pretrain [list pretrain_100_0]
		set habEvent [list sim1bExpHab sim1bCntrlHab] 
		set testEvent [list sim1bTest sim1bTest]
		set pretrainingEpochs [list 900]
		set trainingEpochs [list 8 9 10 11 12]



		# define loop
		foreach cond $condition pEvent $pretrain {
			set workingdirectory "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/data_supMat/ALIAS/sim1b/$cond"
			cd $workingdirectory
			foreach hEvent $habEvent tEvent $testEvent {
				foreach epochs $pretrainingEpochs {
					foreach tEpochs $trainingEpochs {
					testNetwork 20 $pEvent $epochs $hEvent $tEpochs $tEvent pEpochs_${epochs}_tEpochs_${tEpochs}_condition_${cond}_testEvent_${tEvent}_habEvent_${hEvent}_lr_${lr}_sLR_${sLR}_sWD_${sWD}.txt
					}
				}
			}
		}
}

# parameter lists (#differences 125
set learningRate [list 0.09875 0.0975] 
set salientLR [list 0.0004 .0003875]
set salientWD [list 0.09875 0.0975]

# grid search loops
	foreach lrSalient $learningRate sLR $salientLR sWD $salientWD {
		set ::s_LR $sLR
		set ::s_WD $sWD
		
		gsSim_sim1b_100 net100b_${lrSalient}_sLR_${sLR}_sWD_${sWD} $lrSalient $sLR $sWD
	}

}

proc wrapSim1b_90 {} {
	proc gsSim_sim1b_90 {netName lr sLR sWD} {
	addNet $netName -i 8

	# input groups
	addGroup Object_Left_IN 82 INPUT OUT_NOISE
	addGroup Object_Right_IN 82 INPUT  OUT_NOISE
	addGroup Object_Left_Animate_Status_IN 2 INPUT OUT_NOISE 
	addGroup Object_Right_Animate_Status_IN 2 INPUT  OUT_NOISE
	addGroup Grid_IN 5 INPUT  OUT_NOISE
	addGroup Grid_Position_IN 3 INPUT OUT_NOISE 
	addGroup Jump_Height_IN 5 INPUT OUT_NOISE 
	addGroup Motion_IN 6 INPUT OUT_NOISE
	addGroup Motion_Type_IN 2 INPUT OUT_NOISE
	addGroup Goal_IN 1 INPUT OUT_NOISE
	addGroup Clearance_IN 3 INPUT OUT_NOISE

	# hidden group (# there are necessarily fewer hidden units than there are input and output units)
	addGroup context 50 ELMAN
	addGroup hidden 50 RELU
	
	# noise parameters
	noiseType Object_Left_IN -range 0.3
	noiseType Object_Right_IN -range 0.3
	noiseType Object_Left_Animate_Status_IN -range 0.3
	noiseType Object_Right_Animate_Status_IN -range 0.3
	noiseType Grid_IN -range 0.3
	noiseType Grid_Position_IN -range 0.3
	noiseType Jump_Height_IN -range 0.3
	noiseType Motion_IN -range 0.3
	noiseType Motion_Type_IN -range 0.3
	noiseType Goal_IN -range 0.3
	noiseType Clearance_IN -range 0.3
		

	# output group
	addGroup Object_Left_OUT 82 OUTPUT 
	addGroup Object_Right_OUT 82 OUTPUT 
	addGroup Object_Left_Animate_Status_OUT 2 OUTPUT
	addGroup Object_Right_Animate_Status_OUT 2 OUTPUT
	addGroup Grid_OUT 5 OUTPUT 
	addGroup Grid_Position_OUT 3 OUTPUT
	addGroup Jump_Height_OUT 5 OUTPUT
	addGroup Motion_OUT 6 OUTPUT
	addGroup Motion_Type_OUT 2 OUTPUT
	addGroup Goal_OUT 1 OUTPUT  
	addGroup Clearance_OUT 3 OUTPUT


	# connect groups (input -> hidden -> output)
	connectGroups {Object_Left_IN Object_Right_IN Object_Left_Animate_Status_IN Object_Right_Animate_Status_IN Motion_IN Goal_IN Clearance_IN Jump_Height_IN Motion_Type_IN context} hidden {Object_Left_OUT Object_Right_OUT Object_Left_Animate_Status_OUT Object_Right_Animate_Status_OUT Motion_OUT Goal_OUT Clearance_OUT Jump_Height_OUT Motion_Type_OUT}

	connectGroups {Grid_IN Grid_Position_IN} hidden -type barrierSalience
	connectGroups hidden {Grid_OUT Grid_Position_OUT} -type barrierSalience

	elmanConnect hidden context

	deleteGroups bias

	# training examples
	loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/pretrain_100_0.ex" -e PERMUTED
	loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/pretrain_90_10.ex" -e PERMUTED
	loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/pretrain_80_20.ex" -e PERMUTED
	loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/pretrain_70_30.ex" -e PERMUTED
	loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/pretrain_60_40.ex" -e PERMUTED
	loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/pretrain_50_50.ex" -e PERMUTED

	loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/sim1bExpHab.ex" 
	loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/sim1bCntrlHab.ex" 
	loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/sim1bTest.ex"

	# set learning and display parameters
	setObj learningRate $lr
	setObj momentum	    0
	setObj batchSize    0
	setObj numUpdates   10
	setObj randRange 0.1
	setObj reportInterval 0
	setObj pseudoExampleFreq 1

	# create a function that gets the error for each test example
	proc saveActivations {fname} { 
		set outfile [open $fname a] 
		puts $outfile "[getObj currentExample.num] [getObj currentExample.name] " nonewline 
		puts $outfile [getObj exampleError]
		close $outfile 
	}

	proc testAllFinalActs {fname} { 
		resetExampleSet [getObj testingSet.name] 
		set nex [getObj testingSet.numExamples] 
		for {set i 0} {$i < $nex} {incr i} {
			doExample -set [getObj testingSet.name]
			saveActivations $fname
		}
	}

	proc testNetwork {n train trainNum train2 trainNum2 test fname} {
		for {set i 0} {$i < $n} {incr i} {
			resetNet
			useTrainingSet $train
			train $trainNum
			useTrainingSet $train2
			train $trainNum2
			useTestingSet $test
			testAllFinalActs $fname
		}
	}


	# define lists for looping
	set condition [list pretrain9010]
	set pretrain [list pretrain_90_10]
	set habEvent [list sim1bExpHab sim1bCntrlHab] 
	set testEvent [list sim1bTest sim1bTest]
	set pretrainingEpochs [list 900]
	set trainingEpochs [list 8 9 10 11 12]



	# define loop
	foreach cond $condition pEvent $pretrain {
		set workingdirectory "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/data_supMat/ALIAS/sim1b/$cond"
		cd $workingdirectory
		foreach hEvent $habEvent tEvent $testEvent {
			foreach epochs $pretrainingEpochs {
				foreach tEpochs $trainingEpochs {
				testNetwork 20 $pEvent $epochs $hEvent $tEpochs $tEvent pEpochs_${epochs}_tEpochs_${tEpochs}_condition_${cond}_testEvent_${tEvent}_habEvent_${hEvent}_lr_${lr}_sLR_${sLR}_sWD_${sWD}.txt
				}
			}
		}
	}
}

# parameter lists (#differences 125
set learningRate [list 0.09875 0.0975] 
set salientLR [list 0.0004 .0003875]
set salientWD [list 0.09875 0.0975]

# grid search loops
	foreach lrSalient $learningRate sLR $salientLR sWD $salientWD {
		set ::s_LR $sLR
		set ::s_WD $sWD
		
		gsSim_sim1b_90 net90b_${lrSalient}_sLR_${sLR}_sWD_${sWD} $lrSalient $sLR $sWD
	}
}


