		loadExamples "C:/Users/Deon T. Benton/Documents/projects/newGergelySim/psychologicalReview/model/supplementarySimulations/simulation1b/sim1bTest.ex"

		setObj learningRate $lr
		setObj momentum	    0
		setObj batchSize    0
